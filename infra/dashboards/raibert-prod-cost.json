    },
    {
      "type": "metric",
      "x": 0,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RaiBert daily database consumed capacity",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 86400,
        "metrics": [
          [
            "AWS/DynamoDB",
            "ConsumedReadCapacityUnits",
            "TableName",
            "raibert-prod-LeaderboardTable-1NZGDJJSQUM8K",
            {}
          ],
          [
            "AWS/DynamoDB",
            "ConsumedWriteCapacityUnits",
            "TableName",
            "raibert-prod-LeaderboardTable-1NZGDJJSQUM8K",
            {}
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RaiBert stored bytes (daily sample)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Average",
        "period": 86400,
        "metrics": [
          [
            "AWS/S3",
            "BucketSizeBytes",
            "BucketName",
            "raibert-lol-129942367502",
