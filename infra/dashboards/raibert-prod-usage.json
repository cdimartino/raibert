    {
      "type": "log",
      "x": 0,
      "y": 24,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Referrers: visits, starts and active minutes",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/raibert-prod-AnalyticsFunction-oBMXKMienwAg' | filter ispresent(event) | stats sum(PageViews) as pageViews, sum(Sessions) as tabSessions, sum(GameStarts) as gameStarts, sum(ActivePlaySeconds)/60 as activeMinutes by referrer | sort pageViews desc | limit 20"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 24,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Input device: visits and gameplay",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/raibert-prod-AnalyticsFunction-oBMXKMienwAg' | filter ispresent(event) | stats sum(PageViews) as pageViews, sum(GameStarts) as gameStarts, sum(GameOvers) as gameOvers, sum(Victories) as victories, sum(ActivePlaySeconds)/60 as activeMinutes by device | sort pageViews desc"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 30,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Daily activity (UTC days; partial boundary days)",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/raibert-prod-AnalyticsFunction-oBMXKMienwAg' | filter ispresent(event) | stats sum(PageViews) as pageViews, sum(Sessions) as tabSessions, sum(GameStarts) as gameStarts, sum(GameOvers) as gameOvers, sum(Victories) as victories, sum(ActivePlaySeconds)/60 as activeMinutes by bin(1d) as day | sort day desc"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 30,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Freshness: most recent report of each event",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/raibert-prod-AnalyticsFunction-oBMXKMienwAg' | filter ispresent(event) | stats count(*) as reports, max(@timestamp) as lastEvent by event | sort lastEvent desc"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 36,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Recent anonymous events (UTC timestamps)",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/raibert-prod-AnalyticsFunction-oBMXKMienwAg' | filter ispresent(event) | fields @timestamp, event, device, referrer, seconds | sort @timestamp desc | limit 25"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 48,
      "width": 24,
      "height": 4,
      "properties": {
        "markdown": "### How to read this\nActive time excludes paused/hidden gameplay. Starts per session and minutes per start are aggregate ratios, not conversion or average completed-session duration. Runs may cross the selected time boundary. Referrer is the referring hostname; `direct` also includes unavailable referrers. Device reflects coarse-pointer input, not a verified device model.\n\nTracking respects privacy settings and can be blocked, lost, or spoofed. No person IDs, IPs, countries, scores, character or difficulty are collected by this analytics pipeline. No cohort retention or unique-player estimates are inferred. Log tables retain up to 30 days and incur query charges on refresh; avoid rapid auto-refresh. Metrics have longer retention."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 42,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CDN requests / 5 minutes (assets and bots included)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 300,
        "liveData": true,
        "metrics": [
          [
            "AWS/CloudFront",
            "Requests",
            "DistributionId",
            "ECRDPSJN9SGIB",
            "Region",
            "Global"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 42,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CDN bytes downloaded / 5 minutes",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 300,
        "liveData": true,
        "metrics": [
          [
            "AWS/CloudFront",
            "BytesDownloaded",
            "DistributionId",
            "ECRDPSJN9SGIB",
            "Region",
            "Global"
          ]
        ]
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 52,
      "width": 24,
      "height": 8,
      "properties": {
        "title": "Runtime failures by version, browser and safe error location (legacy reports have no details)",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/raibert-prod-AnalyticsFunction-oBMXKMienwAg' | filter event = 'runtime_error' | fields coalesce(diagnostics.release, 'legacy') as release, coalesce(diagnostics.browser, 'unknown') as browser, coalesce(diagnostics.phase, 'unknown') as phase, coalesce(diagnostics.errorType, 'unknown') as errorType, coalesce(diagnostics.source, 'unknown') as source, coalesce(diagnostics.line, 0) as line | stats count(*) as reports, max(@timestamp) as lastSeen by release, browser, phase, errorType, source, line | sort lastSeen desc | limit 50"
      }
    }
  ]
}
