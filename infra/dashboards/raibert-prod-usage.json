{
  "start": "-P1D",
  "periodOverride": "inherit",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 4,
      "properties": {
        "markdown": "# RaiBert analytics\n[Operations](https://console.aws.amazon.com/cloudwatch/home?region=us-east-1#dashboards:name=raibert-prod-operations) \u00b7 [Cost](https://console.aws.amazon.com/cloudwatch/home?region=us-east-1#dashboards:name=raibert-prod-cost)\n\nTotals follow the selected time range. Charts use 5-minute buckets, including partial live data; recent values can change. Refresh to fetch newer data. Sessions are browser-tab sessions, not unique people. Blank means no reported samples, not confirmed zero."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 4,
      "width": 4,
      "height": 4,
      "properties": {
        "title": "Page views",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Sum",
        "period": 300,
        "liveData": true,
        "metrics": [
          [
            "RaiBert/Usage",
            "PageViews",
            "Site",
            "raibert.lol",
            {}
