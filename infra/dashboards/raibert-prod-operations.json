      "x": 0,
      "y": 4,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CDN requests (includes assets and bots)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "Sum",
        "period": 300,
        "metrics": [
          [
            "AWS/CloudFront",
            "Requests",
            "DistributionId",
            "ECRDPSJN9SGIB",
            "Region",
            "Global",
            {}
          ]
        ]
      }
    },
