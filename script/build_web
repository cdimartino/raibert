#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$ROOT/build/web-runtime"
PUBLIC="$ROOT/public/web"
RUBY_IMAGE="ruby@sha256:c88f8a06d935a379623b476680a7aeaf03c85e3f52949a919287dbff62cce3b1"
NODE_IMAGE="node@sha256:de2d8c00f6b1938eefdf575b5c1efa314a48dd8842a5983ec275cb11e8e6685c"
RUBY_TARBALL_SHA256="911ace20f90d068ca0e4dda6d0e4f0f81e52e52f2dd4f4004c721e253412e82d"
BASE_CACHE_KEY="cruby-4.0.7-wasi-sdk-24-ruby-wasm-2.10.1-$RUBY_TARBALL_SHA256"

command -v docker >/dev/null || { echo "Docker is required to rebuild the web runtime." >&2; exit 1; }
docker info >/dev/null || { echo "Docker is not running." >&2; exit 1; }
mkdir -p "$WORK" "$PUBLIC"

docker run --rm --platform linux/amd64 \
  -e BASE_CACHE_KEY="$BASE_CACHE_KEY" \
  -v "$ROOT:/src" -v "$WORK:/work" -w /work "$RUBY_IMAGE" bash -lc '
    set -euo pipefail
    cp /src/web/Gemfile /src/web/Gemfile.lock /work/
    export BUNDLE_GEMFILE=/work/Gemfile
    bundle config set path /work/bundle >/dev/null
    bundle install --quiet
    RUBY_WASM_DIR=$(bundle show ruby_wasm)
    bundle pristine ruby_wasm >/dev/null
    patch -d "$RUBY_WASM_DIR" -p1 < /src/web/ruby_wasm-local-headers.patch
    BASE_SIGNATURE=$(printf "%s\n%s\n%s\n" "$BASE_CACHE_KEY" \
      "$(sha256sum /src/web/Gemfile.lock)" \
      "$(sha256sum /src/web/ruby_wasm-local-headers.patch)" | sha256sum | cut -d " " -f 1)
    if [ ! -f /work/ruby-base.wasm ] || [ ! -f /work/ruby-base.signature ] || [ "$(cat /work/ruby-base.signature)" != "$BASE_SIGNATURE" ]; then
      rm -rf /work/build /work/rubies /work/ruby-4.0.7
      curl -fsSL https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.7.tar.gz -o /work/ruby-4.0.7.tar.gz
      echo "'"$RUBY_TARBALL_SHA256"'  /work/ruby-4.0.7.tar.gz" | sha256sum -c -
      tar -xzf /work/ruby-4.0.7.tar.gz -C /work
      bundle exec rbwasm build --ruby-version /work/ruby-4.0.7 \
        --target wasm32-unknown-wasip1 --build-profile full --stdlib \
        -o /work/ruby-base.wasm
      echo "$BASE_SIGNATURE" > /work/ruby-base.signature
    fi

    rm -rf /work/app /work/ruby-app.wasm
    install -D /src/game.rb /work/app/game.rb
    install -D /src/lib/game_state.rb /work/app/lib/game_state.rb
    install -D /src/lib/demo_window.rb /work/app/lib/demo_window.rb
    install -D /src/config/controls.json /work/app/config/controls.json
    install -D /src/web/gosu.rb /work/app/web/gosu.rb
    install -D /src/web/boot.rb /work/app/web/boot.rb
    bundle exec rbwasm pack /work/ruby-base.wasm --dir /work/app::/app -o /work/ruby-app.wasm
    mkdir -p /work/licenses
    cp /work/ruby-4.0.7/COPYING /work/licenses/CRuby-COPYING
  '

docker run --rm --platform linux/amd64 \
  -v "$ROOT:/src" -v "$WORK:/work" -w /work "$NODE_IMAGE" bash -lc '
    set -euo pipefail
    rm -rf /work/node
    mkdir -p /work/node /work/licenses
    cp /src/web/runtime_entry.js /src/web/package.json /src/web/package-lock.json /work/node/
    cd /work/node
    npm ci >/dev/null
    npx esbuild runtime_entry.js --bundle --format=esm --platform=browser --minify --outfile=/work/ruby-runtime.js
    cp node_modules/@ruby/4.0-wasm-wasi/dist/LICENSE /work/licenses/ruby.wasm-LICENSE
    cp node_modules/@ruby/4.0-wasm-wasi/dist/NOTICE /work/licenses/ruby.wasm-NOTICE
    cp node_modules/@bjorn3/browser_wasi_shim/LICENSE-APACHE /work/licenses/browser-wasi-LICENSE-APACHE
    cp node_modules/@bjorn3/browser_wasi_shim/LICENSE-MIT /work/licenses/browser-wasi-LICENSE-MIT
  '

hash_file() {
  ruby -rdigest -e 'puts Digest::SHA256.file(ARGV.fetch(0)).hexdigest[0, 16]' "$1"
}

WASM_NAME="ruby-$(hash_file "$WORK/ruby-app.wasm").wasm"
JS_NAME="ruby-$(hash_file "$WORK/ruby-runtime.js").js"
find "$PUBLIC" -maxdepth 1 -type f \( -name 'ruby-*.wasm' -o -name 'ruby-*.js' \) -delete
cp "$WORK/ruby-app.wasm" "$PUBLIC/$WASM_NAME"
cp "$WORK/ruby-runtime.js" "$PUBLIC/$JS_NAME"
rm -rf "$PUBLIC/licenses"
cp -R "$WORK/licenses" "$PUBLIC/licenses"
ruby -rjson -e 'File.write(ARGV.fetch(0), JSON.pretty_generate(javascript: ARGV.fetch(1), webassembly: ARGV.fetch(2)) + "\n")' \
  "$PUBLIC/runtime.json" "$JS_NAME" "$WASM_NAME"

echo "Built $JS_NAME and $WASM_NAME"
