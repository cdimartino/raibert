#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

bundle exec ruby test/unit_coverage_test.rb
ruby test/leaderboard_test.rb
ruby test/web_shim_test.rb
bundle exec ruby test/rack_test.rb
bundle exec ruby test/site_test.rb
bundle exec ruby test/gameplay_collision_test.rb
npm --prefix web test
npm --prefix web run test:e2e
